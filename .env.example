# Skopiuj do `.env` i wypełnij. `.env` jest w .gitignore i nigdy nie idzie do repo.
# Pełna tabela sekretów z uzasadnieniami: docs/etapy/05-deploy.md.
#
# Nazwy poniżej to propozycja — poza ANTHROPIC_API_KEY, którą narzuca Agent SDK.
#
# Aplikacja czyta ten plik SAMA (D12) — `export` przed uruchomieniem nie jest
# potrzebny. Zmienna ustawiona w środowisku procesu przebija wartość z pliku,
# więc podmiana tokena na jeden run nie wymaga edycji `.env`. Plik z innej
# lokalizacji wskazuje `MONDAY_AUDIT_ENV_FILE` albo flaga `--plik-env`.
#
# Po wypełnieniu: `chmod 600 .env`. Domyślne prawa `-rw-r--r--` znaczą, że sól
# czyta każdy proces na maszynie, a jej wyciek pozwala zdeanonimizować całą
# tabelę osoby_mapowanie. Program o tym ostrzega, ale nie naprawia.

# ── Anthropic ────────────────────────────────────────────────────────
# Pętla agenta (D1). Nazwa narzucona przez SDK, nie zmieniaj.
ANTHROPIC_API_KEY=

# ── monday.com ───────────────────────────────────────────────────────
# Token read-only od admina konta klienta (D11).
# Wczytuje go `konfiguracja.wczytaj()` i nie wychodzi poza `MondayClient`.
# Nigdy w argv — argv jest widoczne w `ps`. Nigdy w kontekście modelu (D6).
# Po zakończeniu audytu usuwany.
MONDAY_TOKEN=

# ── Pseudonimizacja (etap 3.4) ───────────────────────────────────────
# Sól do HMAC-SHA256 liczącego user_hash. OSOBNA DLA KAŻDEGO KLIENTA.
# Wyciek soli = możliwość deanonimizacji całej tabeli osoby_mapowanie,
# czyli obejście granicy PII z D6. Traktuj jak klucz prywatny.
SOL_PSEUDONIMIZACJI=

# ── Publikacja raportu (etap 3.12) ───────────────────────────────────
# UWAGA: ta zmienna NIE MA jeszcze pola w `Ustawienia` — publikacja raportu
# pod URL-em przeszła do etapu 5 (D9), a skilla publishera w repo nie ma.
# `extra="ignore"` w konfiguracji powoduje, że jej obecność nic nie psuje.
# Zostawiona jako zapowiedź, nie jako działający przełącznik.
CXLABS_DOCS_KEY=

# ── Ścieżki ──────────────────────────────────────────────────────────
# Baza ze snapshotami, findingami i tabelą wywolania. Objęta .gitignore (*.db).
MONDAY_AUDIT_DB=./monday_audit.db

# ── Poczta: „nie pamiętam hasła" (O29) ───────────────────────────────
# WYMAGANE PRZED WYSTAWIENIEM PANELU. Bez SMTP link resetu hasła nie jest
# wysyłany — trafia tylko do logu procesu, gdzie lokalnie widzi go właściciel
# maszyny, a po wdrożeniu KAŻDY z dostępem do journala systemd.
#
# Przy Google Workspace `SMTP_HASLO` to **hasło aplikacji**, nie hasło do konta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_HASLO=
# Domyślnie równe SMTP_USER. Ustaw, gdy nadawca ma być inny niż konto SMTP.
SMTP_NADAWCA=

# ── Adres publiczny (etap 5) ─────────────────────────────────────────
# PUSTE = adres brany z `Request.base_url`, czyli z tego, w co odbiorca kliknął.
# Tak ma być lokalnie: dwa źródła prawdy o porcie już raz rozjechały link
# resetu (serwer na :8010, link na :8000).
#
# USTAW, gdy aplikacja stoi za tunelem albo odwrotnym proxy — wtedy żądanie
# widzi adres wewnętrzny (`127.0.0.1:8000`), a odbiorca zupełnie inny.
# Przykład: https://audyt.cxlabs.digital
ADRES_PUBLICZNY=

# ── Czuwak kontroli zdrowia (Z4, etap 6) ─────────────────────────────
# URL, który `deploy/kontrola-zdrowia.sh` pinguje PO KAŻDEJ udanej kontroli.
# Usługa po drugiej stronie krzyczy, gdy pingi ustaną — i tylko dzięki temu
# dowiesz się o śmierci CAŁEJ maszyny, której lokalny monitor z definicji
# nie zgłosi (nie ma go wtedy kto uruchomić).
#
# DOPÓKI TO JEST PUSTE, Z4 NIE JEST DOMKNIĘTE: wynik kontroli trafia wyłącznie
# do journala, czyli tam, gdzie trzeba zajrzeć z własnej woli.
#
# Traktuj jak sekret: kto zna ten URL, może pingować za serwer i udawać,
# że wszystko żyje. Dlatego tutaj, a nie w jednostce systemd — `systemctl show`
# pokazuje `Environment=` każdemu na maszynie.
URL_CZUWAKA=

# ── Rozliczenie modelu (O36, D17) ────────────────────────────────────
# `true` (domyślnie) = klucz Anthropic podaje KLIENT w panelu i koszt idzie na
# jego rachunek. `false` przywraca wariant, w którym płaci CXLABS — zbudowany
# i przetestowany, na przejście na produkt.
KLUCZ_MODELU_OD_KLIENTA_WYMAGANY=true

# Na czyj rachunek liczymy koszt runu w tabeli `runy.rozliczenie` (D17).
# `klucz` (domyślnie) = płacimy przez ANTHROPIC_API_KEY, kwota jest wydatkiem.
# `subskrypcja` = run idzie z konta subskrypcyjnego, a `koszt_usd` to wtedy
# wycena TEORETYCZNA, nie wydatek — bez tego rozróżnienia sumowanie kosztów
# mieszałoby jedno z drugim.
#
# Run z kluczem KLIENTA dostaje trzecią wartość (`klucz_klienta`) automatycznie,
# niezależnie od tego ustawienia.
AGENT_ROZLICZENIE=klucz

# UWAGA: koszt licencji miesięcznej u klienta (O7) NIE jest tutaj.
# To parametr wejściowy runu, inny dla każdego audytu. Bez niego findingi
# ZOMBIE_ACCOUNT i PLAN_MISMATCH raportują się bez kwoty — nigdy nie zgaduj
# tej liczby.

# ── Langfuse Cloud: trace'y wywołań modelu (plan, faza 4; D10 cofnięta) ──
# JEDYNE miejsce w tym pliku, w którym ustawienie zmiennej powoduje, że dane
# opuszczają serwer. Stąd ostrzejsze reguły niż przy reszcie:
#
#   * TRZY zmienne albo ZERO. Konfiguracja połowiczna przerywa start, zamiast
#     spaść na domyślny region biblioteki — trace'y z EU w US to awaria, która
#     wygląda jak sukces, bo wszystko działa.
#   * Brak wszystkich trzech = wysyłki nie ma i to jest stan domyślny.
#     Nie ma osobnej flagi włączającej; usunięcie klucza JEST wyłącznikiem.
#   * BASE_URL nie ma wartości domyślnej celowo. Region przechowywania danych
#     klienta ma być decyzją, nie skutkiem pominięcia linijki.
#     EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
#
# Przed wysyłką wszystko przechodzi przez `maskowanie.py`. Trafienie wzorca
# NIE jest sukcesem — znaczy, że PII weszło do kontekstu modelu wyżej, i idzie
# do logu jako ostrzeżenie.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
