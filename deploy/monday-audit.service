# Jednostka systemd dla panelu audytu. Kopiuj do /etc/systemd/system/.
#
# Zakłada: użytkownika `audyt`, repo w /opt/monday-audit, sekrety
# w /etc/monday-audit.env (chmod 600, właściciel `audyt`).
#
# Wszystkie ścieżki są ABSOLUTNE i to nie jest ozdoba: `MONDAY_AUDIT_DB`
# domyślnie wskazuje `monday_audit.db` RELATYWNIE do katalogu roboczego, więc
# usługa bez `WorkingDirectory` otworzyłaby (albo UTWORZYŁA) bazę w `/`.

[Unit]
Description=Panel audytu monday.com (CXLABS)
Documentation=file:///opt/monday-audit/deploy/README.md
# `network-online`, nie samo `network`: collector uderza do api.monday.com
# w pierwszej sekundzie runu, a `network.target` nie gwarantuje trasy.
After=network-online.target
Wants=network-online.target

# Po pięciu nieudanych startach w 10 minut systemd przestaje próbować.
# Bez tego zepsuta konfiguracja daje pętlę restartów i zapchany journal.
#
# Te dwa klucze MUSZĄ stać w [Unit]. W [Service] systemd je ignoruje i mówi
# o tym tylko w `systemd-analyze verify` — `systemctl start` nie pisnie, więc
# limit wygląda na działający, a nie działa. Sprawdzone na serwerze 2026-09-01
# (systemd 249, Ubuntu 22.04): „Unknown key name 'StartLimitIntervalSec'
# in section 'Service', ignoring."
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=exec
User=audyt
Group=audyt
WorkingDirectory=/opt/monday-audit

# Pliki tworzone przez usługę mają być czytelne TYLKO dla `audyt`.
#
# Bez tego SQLite tworzy bazę z domyślną umask, czyli `-rw-r--r--` — sprawdzone
# na serwerze 2026-09-02, baza faktycznie taka była. A w bazie jest
# `osoby_mapowanie` (imiona, nazwiska, e-maile pracowników klienta), hasze haseł
# i tokeny sesji. Na maszynie dzielonej z sześcioma cudzymi aplikacjami (D19)
# „czytelne dla wszystkich" nie jest teoretycznym problemem.
#
# Dotyczy też `raporty/`, gdzie findingi są PO deanonimizacji, czyli
# z prawdziwymi nazwiskami.
UMask=0077

# Sekrety WYŁĄCZNIE z pliku, nigdy w tej jednostce: `systemctl show` pokazuje
# `Environment=` każdemu, kto ma dostęp do maszyny, a `EnvironmentFile` już nie.
# Plik musi mieć chmod 600 — sól do pseudonimizacji jest w nim, a jej wyciek
# pozwala zdeanonimizować całą tabelę `osoby_mapowanie`.
EnvironmentFile=/etc/monday-audit.env

# Te dwie NIE są sekretami, więc mogą stać jawnie — i muszą stać tutaj, a nie
# w pliku env, bo bez nich `uv` sięga do katalogu domowego, którego
# `ProtectHome=true` nie pokazuje (szczegóły przy ProtectHome niżej).
#
# `CacheDirectory=` niżej tworzy /var/cache/monday-audit z właścicielem `audyt`
# i sam dopisuje go do ścieżek zapisywalnych — dlatego nie ma go w
# `ReadWritePaths`.
Environment=UV_CACHE_DIR=/var/cache/monday-audit
Environment=UV_PYTHON_INSTALL_DIR=/opt/monday-audit/.uv-python
CacheDirectory=monday-audit

# `--host 127.0.0.1`: panel słucha WYŁĄCZNIE na pętli zwrotnej, a wejściem
# z zewnątrz jest nginx (D19). Do 2026-09-01 stało tu `--host ::` z komentarzem
# „nasłuchuje na IPv6 ORAZ IPv4 (dual-stack)". Oba zdania były nieprawdziwe
# i zmierzone na serwerze:
#
#  1. To NIE jest dual-stack. Python ustawia `IPV6_V6ONLY=1` w
#     `socket.create_server`, niezależnie od `net.ipv6.bindv6only=0` w systemie.
#     Efekt: `[::1]:8000/health` odpowiadał, `127.0.0.1:8000/health` nie.
#     A po 127.0.0.1 pyta `ExecStartPost` niżej, `deploy/wdroz.sh` (i przerwałby
#     KAŻDE wdrożenie komunikatem „usługa NIE jest zdrowa") oraz `proxy_pass`
#     w nginksie, który dostawałby 502.
#  2. `::` to nie tylko pętla zwrotna. Panel odpowiadał na GLOBALNYM adresie
#     IPv6 kontenera, po zwykłym HTTP, z pominięciem Cloudflare i nginxa —
#     przy `policy accept` w nftables i braku reguł. Panel niesie dane osobowe
#     pracowników klienta (O23), więc to była realna ekspozycja, nie teoria.
#
# Ceną jest droga zapasowa 2d z README: subdomena `mikrus.cloud` wymaga
# nasłuchu na IPv6 kontenera. Gdyby kiedyś była potrzebna, wraca `--host ::`
# — ale wtedy świadomie, z zaporą, a nie przy okazji.
#
# `uv run --frozen`: odtwarza DOKŁADNIE wersje z `uv.lock`. Bez `--frozen` restart
# usługi mógłby cicho podnieść inną wersję zależności niż ta przetestowana w CI.
#
# `--no-dev` NIE jest tu powtórzeniem tego, co robi `uv sync` przy wdrożeniu.
# `uv run` synchronizuje środowisko PRZED uruchomieniem komendy i domyślnie
# bierze grupę `dev`. Zmierzone na serwerze 2026-09-01: po `uv sync --frozen
# --no-dev` środowisko ma 298 MB i zero narzędzi deweloperskich, a samo
# `uv run --frozen` dociąga 24 pakiety (ruff, mypy, pytest, virtualenv) i robi
# z tego 405 MB. Bez `--no-dev` każdy `systemctl start` sięgałby do sieci po
# rzeczy, których produkcja nie używa, i przepisywał środowisko pod działającą
# usługą.
#
# Ścieżka do `uv` jest bezwzględna, bo `ExecStart` nie przeszukuje PATH — i musi
# być to `/usr/local/bin`, a nie domyślne `~/.local/bin` instalatora, bo usługa
# startuje jako `audyt`, a instalację robi root. Stąd `UV_INSTALL_DIR` w kroku 1
# deploy/README.md. Niezgodność daje `status=203/EXEC`.
ExecStart=/usr/local/bin/uv run --frozen --no-dev python -m monday_audit.cli_web \
    --serwuj --host 127.0.0.1 --port 8000

# Migracje aplikują się same przy starcie (`cli_web` woła `przygotuj_baze`
# PRZED uvicornem), więc tu tylko potwierdzamy, że usługa odpowiada.
# `|| true` — nieudany health nie ma zabijać usługi, która właśnie wstała;
# ma zostawić ślad w journalu.
ExecStartPost=/bin/sh -c 'sleep 3; curl -fsS http://127.0.0.1:8000/health || true'

Restart=on-failure
RestartSec=5
# Limit prób startu stoi w [Unit], nie tutaj — patrz komentarz tam.

# ── Ograniczenia procesu ─────────────────────────────────────────────────
#
# `ulimit -c 0`: zrzut pamięci przy awarii zawierałby klucz API klienta, który
# żyje w pamięci procesu przez czas runu (O25). Na Mikrusie trzeba jeszcze
# sprawdzić, czy systemd-coredump nie zbiera zrzutów niezależnie.
LimitCORE=0

# Bez podnoszenia uprawnień i bez dostępu do reszty systemu.
#
# `ProtectHome=true` JEDNAK przeszkadza — wbrew temu, co stało tu do
# 2026-09-01. Repo faktycznie jest w /opt, ale `uv` domyślnie trzyma w katalogu
# domowym dwie rzeczy, bez których usługa nie ruszy:
#
#   /home/audyt/.local/share/uv/python/…  — SAM INTERPRETER (108 MB).
#                                           `.venv/bin/python` to dowiązanie tam.
#   /home/audyt/.cache/uv                 — cache pobrań (401 MB).
#
# Pierwszy start padł na `Failed to initialize cache at /home/audyt/.cache/uv:
# Permission denied`, a nawet po naprawieniu cache'u padłby na interpreterze.
# Dlatego oba są przeniesione poniżej pod ścieżki, które ta jednostka widzi
# — `ProtectHome=true` zostaje.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Jedyne miejsca do zapisu: baza i katalogi wyników. `raporty/` zawiera
# findingi PO deanonimizacji, czyli prawdziwe imiona — dlatego lista jest jawna,
# a nie `ProtectSystem=false`.
ReadWritePaths=/opt/monday-audit

# Log do journala. Bez własnego pliku: rotacja i limity są już w journaldzie,
# a `logger.warning` z `_bez_sekretow` i tak przechodzi przez filtr sekretów.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monday-audit

[Install]
WantedBy=multi-user.target
