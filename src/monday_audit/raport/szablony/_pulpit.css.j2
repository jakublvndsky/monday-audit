{# Powłoka paneli — układ z CXLABS Docs Publisher.

   Ciemny sidebar (ink) po lewej, jasna treść po prawej, karty 16 px, duże
   liczby w Clash Display, sekcje z eyebrow i szewronem. Wzorowane na waszym
   istniejącym produkcie, żeby panel audytu nie wyglądał jak inna firma.

   Zakłada, że tokeny z `_marka.css.j2` są już włączone w tym samym <style>.

   BEZ INTERAKTYWNOŚCI poza `<details>`. Filtry, sortowanie i wykresy czekają
   na front w JS — w jinja2 wyszłyby toporne, a robilibyśmy je dwa razy.
#}
  /* ── Powłoka: sidebar + treść ─────────────────────────────────────── */
  body { max-width: none; padding: 0; display: flex; min-height: 100vh; }

  .sidebar {
    flex: 0 0 240px; background: var(--cx-ink); color: var(--fg-on-dark);
    padding: var(--space-5) 0; display: flex; flex-direction: column;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .sidebar__marka { padding: 0 var(--space-5) var(--space-6); }
  .sidebar__marka img { height: 32px; width: auto; display: block; }
  .sidebar__marka small {
    display: block; margin-top: var(--space-2); font-size: var(--fs-xs);
    color: var(--fg-on-dark-subtle); letter-spacing: .04em;
  }
  .sidebar nav { display: flex; flex-direction: column; gap: 2px; }
  .sidebar a, .sidebar span.poz {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-3) var(--space-5); font-size: var(--fs-small);
    color: var(--cx-lime-soft); text-decoration: none;
  }
  .sidebar a:hover { background: var(--cx-ink-surface, rgb(48, 68, 69)); }
  .sidebar a.aktywny {
    background: var(--cx-ink-surface, rgb(48, 68, 69));
    color: var(--cx-white); box-shadow: inset 3px 0 0 var(--cx-lime);
  }
  .sidebar__licznik {
    margin-left: auto; font-size: var(--fs-xs); color: var(--fg-on-dark-subtle);
  }
  .sidebar__stopka {
    margin-top: auto; padding: var(--space-5) var(--space-5) 0;
    border-top: 1px solid var(--cx-ink-60); font-size: var(--fs-xs);
    color: var(--fg-on-dark-subtle);
  }

  .tresc { flex: 1 1 auto; min-width: 0; background: var(--cx-mist); }
  .pasek {
    display: flex; align-items: center; gap: var(--space-4);
    padding: var(--space-4) var(--space-6); background: var(--cx-white);
    border-bottom: 1px solid var(--border-subtle);
  }
  .okruszki { font-size: var(--fs-small); color: var(--fg-subtle); }
  .okruszki b { color: var(--fg); font-weight: 500; }
  .pasek__prawo { margin-left: auto; display: flex; align-items: center; gap: var(--space-3); }

  /* Drop-down klientów. `<select>` bez JS-a — w makiecie pokazuje wzorzec,
     a przełączanie widoku dorobi front w JS. */
  .wybor-klienta {
    font-family: var(--font-body); font-size: var(--fs-small);
    padding: var(--space-2) var(--space-3); border: 1px solid var(--border);
    border-radius: var(--radius-md); background: var(--cx-white); color: var(--fg);
    max-width: 22rem;
  }
  .plomba-odbiorcy {
    padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill, 9999px);
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .06em;
  }
  .plomba-odbiorcy--wewn { background: var(--cx-ink); color: var(--cx-lime); }
  .plomba-odbiorcy--klient { background: var(--cx-lime); color: var(--cx-ink); }

  .strona { padding: var(--space-6) var(--space-6) var(--space-8); }
  .strona > h1 { margin: 0 0 var(--space-2); }
  .strona__adres { font-size: var(--fs-small); color: var(--fg-subtle); margin: 0 0 var(--space-6); }

  /* ── Kafle liczbowe ───────────────────────────────────────────────── */
  .kafle-gorne {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4); margin: 0 0 var(--space-6);
  }
  .kafel-duzy {
    background: var(--cx-white); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5);
  }
  .kafel-duzy small {
    display: block; font-size: var(--fs-small); color: var(--fg-subtle);
    margin-bottom: var(--space-2);
  }
  .kafel-duzy b {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 40px; line-height: var(--lh-tight);
  }
  .kafel-duzy .pod { font-size: var(--fs-xs); color: var(--fg-subtle); margin-top: var(--space-1); }
  .kafel-duzy--akcent { background: var(--cx-ink); border-color: var(--cx-ink);
    -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .kafel-duzy--akcent small { color: var(--cx-lime-soft); }
  .kafel-duzy--akcent b { color: var(--cx-lime); }
  .kafel-duzy--akcent .pod { color: var(--cx-lime-soft); }

  /* ── Sekcje zwijane ───────────────────────────────────────────────── */
  .sekcja {
    background: var(--cx-white); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg); margin: 0 0 var(--space-5);
    overflow: hidden;
  }
  .sekcja > summary {
    display: flex; align-items: baseline; gap: var(--space-4);
    padding: var(--space-4) var(--space-5); cursor: pointer;
    text-transform: none; letter-spacing: normal; color: var(--fg);
    font-size: var(--fs-h3); font-family: var(--font-display);
  }
  .sekcja > summary::marker, .sekcja > summary::-webkit-details-marker { color: var(--fg-subtle); }
  .sekcja > summary .opis {
    font-family: var(--font-body); font-size: var(--fs-small); color: var(--fg-subtle);
  }
  .sekcja__ciało { padding: 0 var(--space-5) var(--space-5); }

  /* Siatka metryk wewnątrz sekcji — mniejsze niż kafle górne.
     `align-items: stretch` plus `flex` w karcie: bez tego karty w jednym
     wierszu rozjeżdżały się na wysokość najdłuższego opisu, a siatka wyglądała
     na połamaną. Widać to było tylko na zrzucie ekranu, nie w testach. */
  .metryki {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3); align-items: stretch;
  }
  .metryka {
    padding: var(--space-3) var(--space-4); background: var(--bg-alt);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    display: flex; flex-direction: column; gap: 2px;
  }
  .metryka .udzial { color: var(--fg-muted); }
  /* Opis oddzielony kreską u góry, bo bez niej zlewał się z procentem
     w jedno zdanie: „99.0% z 105 statystyki są na poziomie konta". */
  .metryka__opis {
    margin-top: var(--space-2); padding-top: var(--space-2);
    border-top: 1px solid var(--border-subtle);
    color: var(--fg-subtle); line-height: 1.35;
  }
  .metryka b {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: var(--fs-h3); line-height: var(--lh-tight);
  }
  .metryka small { font-size: var(--fs-xs); color: var(--fg-subtle); }
  .metryka--uwaga { border-left: 3px solid var(--waga-wysoka); }

  /* Pasek udziału — dla rozkładów typu „36 z 95 to agenci" */
  .pasek-udzialu {
    height: 6px; border-radius: var(--radius-pill, 9999px);
    background: var(--cx-cloud); overflow: hidden; margin-top: var(--space-2);
  }
  .pasek-udzialu > span { display: block; height: 100%; background: var(--cx-lime); }

  .tabela-lista { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .tabela-lista th, .tabela-lista td {
    text-align: left; padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border-subtle); vertical-align: top;
  }
  .tabela-lista th {
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .04em;
    color: var(--fg-subtle); font-weight: 500;
  }
  .tabela-lista tr:last-child td { border-bottom: 0; }

  .brak-danych {
    padding: var(--space-4) var(--space-5); background: var(--bg-alt);
    border: 1px dashed var(--border); border-radius: var(--radius-md);
    font-size: var(--fs-small); color: var(--fg-muted);
  }

  @media (max-width: 900px) {
    body { flex-direction: column; }
    .sidebar { flex: none; flex-direction: row; align-items: center; padding: var(--space-3); }
    .sidebar nav, .sidebar__stopka { display: none; }
  }
  @media print {
    .sidebar, .pasek__prawo { display: none; }
    .tresc { background: none; }
    .strona { padding: 0; }
    .sekcja { break-inside: avoid; }
  }
