{# Szablon raportu z audytu monday.com (3.12).

   WYGLĄD, nie logika. Co wchodzi do dokumentu, decyduje `raport.py` — tutaj
   nie ma i nie może być filtrowania odbiorcy „na wszelki wypadek". Treść
   wewnętrzna nie dociera do tego pliku, bo nie wchodzi do struktury `r`.

   Styl jest neutralny i tymczasowy: firmowy CSS podmienia się w tym jednym
   pliku, bez dotykania kodu liczącego kwoty.

   Jeden plik, zero zasobów zewnętrznych — dokument musi otwierać się z dysku
   i drukować do PDF u kogoś, kto nie ma dostępu do naszej sieci.
#}
{% from "_makra.html.j2" import wartosc_dowodu %}
<title>Audyt konta monday.com — {{ r.client_id }} — {{ r.run_at[:10] }}</title>
<style>
{% include "_marka.css.j2" %}
  /* ── Nagłówek na ciemnym ink — sygnatura marki ─────────────────────── */
  .naglowek {
    margin: 0 calc(-1 * var(--space-8)) var(--space-7);
    padding: var(--space-7) var(--space-8) var(--space-6);
    background: linear-gradient(180deg, var(--cx-ink-80) 0%, var(--cx-ink) 100%);
    color: var(--fg-on-dark);
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .naglowek h1 { color: var(--fg-on-dark); }
  .znak { height: 40px; width: auto; margin-bottom: var(--space-5); display: block; }
  .meta { color: var(--fg-on-dark-subtle); font-size: var(--fs-small); margin: var(--space-3) 0 0; }
  .meta span + span::before { content: " · "; }
  .plomba {
    display: inline-block; margin-top: var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--cx-ink-60); border-radius: var(--radius-xs);
    font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .08em;
    color: var(--cx-lime);
  }

  /* ── Statystyki: liczby duże, wsparcie małe (README marki) ─────────── */
  .kafle { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-5) 0; }
  .kafel {
    flex: 1 1 8rem; padding: var(--space-4) var(--space-5);
    background: var(--bg-alt); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
  }
  .kafel b {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 40px; line-height: var(--lh-tight);
  }
  .kafel small { color: var(--fg-muted); font-size: var(--fs-small); }
  .oszczednosc {
    margin: var(--space-5) 0; padding: var(--space-5) var(--space-6);
    background: var(--cx-ink); color: var(--fg-on-dark);
    border-radius: var(--radius-xl);
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .oszczednosc .liczba {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 56px; line-height: var(--lh-tight); color: var(--cx-lime);
  }
  .oszczednosc small { color: var(--cx-lime-soft); font-size: var(--fs-small); }

  @media print {
    body { max-width: none; padding: 0 0 var(--space-5); font-size: 10.5pt; }
    .naglowek { margin: 0 0 var(--space-6); }
    h2 { page-break-after: avoid; }
    details { display: none; }
    .kafel { background: none; }
  }
</style>

<header class="naglowek">
  {% if logo %}
    <img class="znak" src="{{ logo }}" alt="CXLABS">
  {% endif %}
  <h1>Audyt konta monday.com</h1>
  <p class="meta">
    <span>{{ r.client_id }}</span>
    <span>{{ r.run_at[:10] }}</span>
    <span>zakres: {{ r.zakres }}</span>
    <span>plan: {{ r.plan_tier }}</span>
  </p>
  {% if not r.dla_klienta %}
    <span class="plomba">wersja wewnętrzna — nie wysyłać klientowi</span>
  {% endif %}
</header>

<h2>Podsumowanie</h2>
{% if r.findingow %}
  <div class="kafle">
    <div class="kafel">
      <b>{{ r.findingow }}</b>
      <small>{{ odmiana(r.findingow, 'znalezisko', 'znaleziska', 'znalezisk') }}</small>
    </div>
    {% for waga, ile in r.po_wagach.items() %}
      <div class="kafel"><b>{{ ile }}</b><small>{{ waga | slownie }}</small></div>
    {% endfor %}
  </div>
  {% if r.ma_kwoty %}
    <div class="oszczednosc">
      <span class="liczba">{{ '{:,.0f}'.format(r.suma_kwot).replace(',', ' ') }} PLN</span>
      <small>możliwa oszczędność roczna na licencjach monday</small>
    </div>
  {% else %}
    <p class="pusto">
      Bez kwot — nie podano stawki licencji, więc żadne znalezisko nie zostało wycenione.
    </p>
  {% endif %}
{% else %}
  <p class="pusto">Ten run nie dał żadnego znaleziska widocznego w tej wersji raportu.</p>
{% endif %}

{% if r.stawki %}
  <h2>Podstawa wyceny</h2>
  <p class="eyebrow">Skąd te liczby</p>
  <p>
    Kwoty w tym raporcie to oszczędności na licencjach monday, policzone z tych
    stawek. Każda pokazuje, skąd pochodzi i kiedy została zapisana.
  </p>
  <div class="przewijane">
    <table>
      <thead>
        <tr><th>pozycja</th><th>wartość</th><th>źródło</th><th>zapisano</th></tr>
      </thead>
      <tbody>
        {% for s in r.stawki %}
          <tr>
            <td>{{ s.pozycja }}</td>
            <td>{{ s.wartosc }} {{ s.waluta or s.jednostka }}</td>
            <td>{{ s.zrodlo }}{% if not s.wolno_liczyc %} — <b>przeterminowana</b>{% endif %}</td>
            <td>{{ s.pobrano_at[:10] }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

{% if r.findingi %}
  <h2>Znaleziska</h2>
  <p class="eyebrow">Kolejność: waga, potem koszt naprawy</p>
  {% for f in r.findingi %}
    <article class="finding {{ f.waga }}">
      {% if f.kwota_pln %}
        <span class="kwota">{{ '{:,.0f}'.format(f.kwota_pln).replace(',', ' ') }} PLN / rok</span>
      {% endif %}
      <h3>{{ loop.index }}. {{ f.nazwa }}</h3>
      <p class="etykiety">
        waga <b>{{ f.waga | slownie }}</b> · naprawa <b>{{ f.wysilek | slownie }}</b> ·
        pewność <b>{{ f.pewnosc | slownie }}</b>
      </p>
      <p>{{ f.opis }}</p>
      <div class="rekomendacja">
        <strong>Co zrobić</strong>
        {{ f.rekomendacja }}
      </div>
      {% if f.trop %}
        <p class="trop"><b>Trop:</b> {{ f.trop }}</p>
      {% endif %}
      {% if f.dowod %}
        <details>
          <summary>Dowód ({{ f.dowod | length }} {{ odmiana(f.dowod | length, 'pole', 'pola', 'pól') }})</summary>
          <dl class="dowod">
            {% for klucz, wartosc in f.dowod.items() %}
              <dt>{{ klucz | etykieta }}</dt>
              <dd>{{ wartosc_dowodu(wartosc) }}</dd>
            {% endfor %}
          </dl>
        </details>
      {% endif %}
    </article>
  {% endfor %}
{% endif %}

<h2>Czego ten audyt nie widzi</h2>
{% if r.zastrzezenia %}
  <div class="uwaga">
    <p>Zebrane dane mają granice. Bez tej listy raport sugerowałby pokrycie, którego nie ma:</p>
    <ul>
      {% for z in r.zastrzezenia %}
        <li>{{ z }}</li>
      {% endfor %}
    </ul>
  </div>
{% else %}
  <p class="pusto">Snapshot nie zgłosił zastrzeżeń co do zakresu.</p>
{% endif %}

{% if not r.dla_klienta %}
  <h2>Hipotezy odrzucone przez agenta ({{ r.hipotezy_odrzucone | length }})</h2>
  <p class="eyebrow">Sprawdzone i obalone</p>
  <p>
    Detektor je wzbudził, analiza ich nie potwierdziła. Agent potwierdzający
    wszystko byłby bezużyteczny — ta lista jest miarą, że sprawdzenie było realne.
  </p>
  {% if r.hipotezy_odrzucone %}
    <div class="przewijane">
      <table>
        <thead><tr><th>klasa</th><th>obiekt</th><th>powód odrzucenia</th></tr></thead>
        <tbody>
          {% for h in r.hipotezy_odrzucone %}
            <tr>
              <td>{{ h.klasa_id }}</td>
              <td>{{ h.obiekt_id or '—' }}</td>
              <td>{{ h.powod }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p class="pusto">
      Brak zapisanych odrzuceń. Dla runów starszych niż 2026-08-05 to normalne —
      tabela nie miała wtedy pisarza.
    </p>
  {% endif %}

  <h2>Odrzucone na walidacji ({{ r.findingi_odrzucone | length }})</h2>
  <p class="eyebrow">Nasza jakość, nie agenta</p>
  <p>
    Finding, który nie spełnił kontraktu D8. Odsetek odrzuconych jest główną
    metryką etapu 4.
  </p>
  {% if r.findingi_odrzucone %}
    <div class="przewijane">
      <table>
        <thead><tr><th>klasa</th><th>reguła</th><th>powód</th></tr></thead>
        <tbody>
          {% for o in r.findingi_odrzucone %}
            <tr>
              <td>{{ o.klasa_id or '—' }}</td>
              <td>{{ o.regula }}</td>
              <td>{{ o.powod }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <p class="pusto">Nic nie odpadło na walidacji.</p>
  {% endif %}

  <h2>Pinowanie i koszt</h2>
  <p class="eyebrow">Odtwarzalność runu</p>
  <div class="przewijane">
    <table>
      <tbody>
        {% for klucz, wartosc in r.pinowanie.items() %}
          <tr><th>{{ klucz }}</th><td>{{ wartosc if wartosc is not none else '—' }}</td></tr>
        {% endfor %}
        <tr>
          <th>koszt runu</th>
          <td>
            {% if r.koszt_usd %}{{ '%.4f' % r.koszt_usd }} USD{% else %}nie zapisany{% endif %}
          </td>
        </tr>
        {% if r.nieznane_hashe %}
          <tr>
            <th>hashe bez mapowania</th>
            <td>{{ r.nieznane_hashe }} — sprawdź, czy snapshot i sól są od tego klienta</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
{% endif %}

<footer>
  Raport wygenerowany z zamrożonego snapshotu — run <code>{{ r.run_id }}</code>.
  Znaleziska opierają się wyłącznie na danych z tego snapshotu; każde ma dowód
  wskazujący na konkretny fakt. CXLABS.
</footer>
