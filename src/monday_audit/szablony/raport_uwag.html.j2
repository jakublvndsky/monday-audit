{# Raport uwag krytycznych — ekrany C i D z projektu Claude Design (docs/design/
   AuditModule.dc.html), wariant „hero". Markup i style PRZENIESIONE 1:1 z projektu
   (2026-09-25, po uwadze Kuby „praktycznie nie pokrywa się z designem"): pętle
   i warunki `sc-for`/`sc-if` przepisane na Jinja, `cqw` zostaje (kontener = korzeń).

   Różnice wobec projektu, każda świadoma:
   - bez baneru „Zapisz ten raport teraz", linku „Historia audytów" i bloku zespołu —
     to widok portalu, a plik idzie do klienta (decyzja 2026-09-25),
   - przejście do kategorii to kotwica i `:target` (jeden plik, zero skryptów),
   - fonty nie są osadzone (D14), animacje pominięte.

   Dokument niesie NAZWISKA pracowników klienta. Powstaje raz, nie ma kopii na serwerze.
#}
<!doctype html>
<html lang="pl">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Raport audytu monday.com — {{ r.konto_nazwa or r.client_id }} — {{ r.run_at[:10] }}</title>
<style>
  /* Tokeny i klasy z CXLABS Design System (colors_and_type.css) — bez fontów (D14). */
  :root {
    --cx-ink: rgb(18, 32, 33); --cx-ink-80: rgb(36, 56, 56); --cx-ink-60: rgb(48, 85, 85);
    --cx-ink-40: rgb(112, 156, 154); --cx-ink-20: rgb(139, 189, 184); --cx-ink-10: rgb(73, 131, 129);
    --cx-lime: rgb(173, 247, 99); --cx-lime-soft: rgb(219, 236, 233);
    --cx-mist: rgb(244, 249, 248); --cx-paper: rgb(246, 247, 248);
    --cx-cloud: rgb(234, 235, 237); --cx-cloud-2: rgb(220, 222, 225);
    --cx-gray-1: rgb(50, 51, 56); --cx-gray-2: rgb(97, 98, 107); --cx-gray-3: rgb(146, 150, 159);
    --shadow-md: 0 8px 16px rgba(0, 0, 0, 0.06);
    --font-display: "Clash Display", "Avenir Next", "Avenir", Helvetica, sans-serif;
    --font-body: "Avenir", "Avenir Next", Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  /* BEZ globalnego `border-box`: projekt liczy `max-width: 960px` dla treści, a odstępy
     dochodzą na zewnątrz. Z `border-box` treść była o 128 px węższa i kolumny się zawijały. */
  html, body { margin: 0; font-family: var(--font-body); font-size: 16px; line-height: 1.5;
               color: var(--cx-ink); background: var(--cx-mist); -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 400; line-height: 1.2; letter-spacing: -0.01em; margin: 0; }
  p { margin: 0; }
  a { color: var(--cx-ink-10); text-decoration: none; }
  a:hover { color: var(--cx-ink); }
  .cx-eyebrow { font-size: 14px; color: var(--cx-ink-40); display: inline-flex; align-items: center; gap: 12px; }
  .cx-chev, .cx-eyebrow::before {
    width: 16px; height: 13px; background: currentColor; display: inline-block;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 13'><path d='M7 6.5 L0 0 L2.5 0 L9 6.5 L2.5 13 L0 13 Z M14 6.5 L7 0 L9.5 0 L16 6.5 L9.5 13 L7 13 Z'/></svg>") no-repeat center / contain;
            mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 13'><path d='M7 6.5 L0 0 L2.5 0 L9 6.5 L2.5 13 L0 13 Z M14 6.5 L7 0 L9.5 0 L16 6.5 L9.5 13 L7 13 Z'/></svg>") no-repeat center / contain;
  }
  .cx-eyebrow::before { content: ""; }
  .cx-btn { display: inline-flex; align-items: center; gap: 24px; height: 48px; padding: 4px 4px 4px 24px;
            border-radius: 12px; border: 1px solid transparent; background: var(--cx-lime); color: var(--cx-ink);
            font-size: 16px; line-height: 1.5; white-space: nowrap; flex-shrink: 0; }
  .cx-btn:hover { filter: brightness(0.96); color: var(--cx-ink); }
  .cx-btn__chev { width: 40px; height: 40px; border-radius: 8px; background: var(--cx-ink); color: var(--cx-lime);
                  display: inline-flex; align-items: center; justify-content: center; }
  .cx-bg-hero { background: linear-gradient(180deg, var(--cx-ink-80) 0%, var(--cx-ink) 100%); color: var(--cx-mist); }

  /* Przełączanie widoków kotwicą: raport główny domyślnie, kategoria po kliknięciu. */
  .widok { display: none; }
  .widok:target { display: block; }
  body:has(.widok:target) #glowny { display: none; }
  #glowny { display: block; }

  .kat-wiersz { color: var(--cx-mist); transition: color 150ms ease; }
  .kat-wiersz:hover { color: var(--cx-lime); }
  .grupa-wiersz-nag { display: flex; }
  .etykieta-m { display: none; font-size: 13px; color: var(--cx-gray-2); }
  @container (max-width: 720px) {
    .grupa-wiersz-nag { display: none; }
    .etykieta-m { display: block; }
  }
  @media print {
    body { background: #fff; }
    .widok, #glowny { display: block !important; }
    .widok { break-before: page; }
    .wroc { display: none !important; }
  }
</style>

{% set kolory = ["var(--cx-lime)", "var(--cx-ink-20)", "var(--cx-ink-40)", "var(--cx-ink-10)"] %}
{% set konto = r.konto_nazwa or r.client_id %}
{% set naj = r.zmierzone | selectattr("uwag") | list %}
{# „Zacznij od tablic", nie „od tablice" — dopełniacz per kategoria. #}
{% set dopelniacz = {"tablice": "tablic", "uzytkownicy": "użytkowników", "workspace": "workspace'ów", "agenci": "agentów AI"} %}

{% macro naglowek(tytul, okruszki) %}
  <div style="background:#fff;border-bottom:1px solid var(--cx-cloud);">
    <div style="max-width:960px;margin:0 auto;padding:clamp(20px,3cqw,32px) clamp(20px,5cqw,64px);display:flex;flex-wrap:wrap;gap:16px 32px;align-items:flex-end;justify-content:space-between;">
      <div style="display:flex;flex-direction:column;gap:10px;min-width:0;">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:14px;color:var(--cx-gray-2);">
          {% for etykieta, cel in okruszki %}
          <span style="display:flex;align-items:center;gap:6px;">
            {% if not loop.first %}<span style="color:var(--cx-gray-3);">/</span>{% endif %}
            {% if cel %}<a href="{{ cel }}" style="color:var(--cx-ink-10);">{{ etykieta }}</a>{% else %}<span>{{ etykieta }}</span>{% endif %}
          </span>
          {% endfor %}
        </div>
        <h1 style="font-size:clamp(28px,3.4cqw,40px);">{{ tytul }}</h1>
        <div style="display:flex;align-items:flex-start;gap:8px;font-size:14px;color:var(--cx-gray-2);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <span>Audyt tylko czyta Twoje konto monday.com. Nie ma technicznej możliwości wprowadzenia na nim zmian.</span>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}

{% macro metadane(powrot) %}
  <div style="display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between;">
    <div style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;font-size:14px;color:var(--cx-gray-2);">
      <span style="display:inline-flex;align-items:center;gap:6px;background:var(--cx-lime);color:var(--cx-ink);border-radius:8px;padding:3px 10px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Zakończona</span>
      <span style="color:var(--cx-ink);font-weight:600;">{{ konto }}</span>
      {% if r.plan %}<span>Plan {{ r.plan | capitalize }}</span>{% endif %}
      <span>analiza z {{ r.run_at[8:10] }}.{{ r.run_at[5:7] }}.{{ r.run_at[:4] }}</span>
    </div>
    {% if powrot %}<a class="wroc" href="#glowny" style="font-size:14px;display:inline-flex;align-items:center;gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>Wróć do raportu głównego</a>{% endif %}
  </div>
{% endmacro %}

<div style="container-type:inline-size;background:var(--cx-mist);min-height:100vh;">
  <div style="background:var(--cx-ink);color:var(--cx-mist);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(16px,4cqw,40px);height:56px;">
    <div style="display:flex;align-items:center;gap:10px;">
      <span class="cx-chev" style="color:var(--cx-lime);width:18px;height:15px;"></span>
      <span style="font-family:var(--font-display);font-size:18px;letter-spacing:0.02em;">CXLABS</span>
    </div>
    <div style="font-size:14px;color:var(--cx-lime-soft);">{{ konto }}</div>
  </div>

  {# ═══ C · RAPORT GŁÓWNY ══════════════════════════════════════════════ #}
  <main id="glowny">
    {{ naglowek("Raport audytu", [("Audyt monday.com", None), ("Raport z " ~ r.run_at[8:10] ~ "." ~ r.run_at[5:7] ~ "." ~ r.run_at[:4], None)]) }}
    <div style="max-width:960px;margin:0 auto;padding:clamp(24px,4cqw,48px) clamp(20px,5cqw,64px) clamp(48px,6cqw,80px);display:flex;flex-direction:column;gap:clamp(20px,3cqw,32px);">
      {{ metadane(False) }}

      <div class="cx-bg-hero" style="border-radius:24px;padding:clamp(24px,4cqw,48px);display:flex;flex-direction:column;gap:28px;">
        <div style="display:flex;flex-wrap:wrap;gap:24px 48px;align-items:flex-end;justify-content:space-between;">
          <div style="display:flex;flex-direction:column;gap:14px;flex:1 1 320px;min-width:0;">
            <span class="cx-eyebrow">Wynik audytu</span>
            <div style="display:flex;align-items:flex-end;gap:20px;flex-wrap:wrap;">
              <span style="font-family:var(--font-display);font-weight:300;font-size:clamp(88px,11cqw,128px);line-height:0.9;letter-spacing:-0.02em;color:var(--cx-lime);font-variant-numeric:tabular-nums;">{{ r.uwagi | length }}</span>
              <span style="font-family:var(--font-display);font-size:clamp(24px,2.8cqw,32px);color:var(--cx-mist);line-height:1.15;padding-bottom:6px;display:flex;flex-direction:column;"><span style="white-space:nowrap;">{{ odmiana(r.uwagi | length, "uwaga krytyczna", "uwagi krytyczne", "uwag krytycznych") }}</span><span style="white-space:nowrap;">na Twoim koncie</span></span>
            </div>
            <p style="color:var(--cx-lime-soft);max-width:560px;">Każda uwaga ma opis, rekomendację i dowód z konta. Wybierz kategorię, żeby zobaczyć szczegóły.</p>
          </div>
          {% if naj %}<a class="cx-btn" href="#kat-{{ naj[0].id }}">Zacznij od {{ dopelniacz.get(naj[0].id, naj[0].nazwa | lower) }}<span class="cx-btn__chev"><span class="cx-chev"></span></span></a>{% endif %}
        </div>
        {% if naj %}
        <div style="display:flex;gap:3px;height:14px;border-radius:7px;overflow:hidden;">
          {% for k in naj %}<span style="flex:{{ k.uwag }} 1 0;background:{{ kolory[loop.index0 % 4] }};"></span>{% endfor %}
        </div>
        {% endif %}
        <div style="display:flex;flex-direction:column;">
          {% for k in r.kategorie %}
          {% if k.niezmierzona %}
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding:18px 0;border-top:1px dashed var(--cx-ink-60);color:var(--cx-ink-40);">
            <div style="flex:0 0 160px;display:flex;align-items:center;gap:12px;">
              <span style="width:12px;height:12px;border-radius:3px;border:1.5px dashed var(--cx-ink-40);flex:none;"></span>
              <span style="font-size:17px;">{{ k.nazwa }}</span>
            </div>
            <span style="flex:0 0 110px;font-family:var(--font-display);font-size:20px;line-height:1.2;">jeszcze nie mierzone</span>
            <span style="flex:1 1 280px;min-width:0;font-size:15px;line-height:1.45;">{{ k.niezmierzona }}</span>
          </div>
          {% else %}
          {% set kolor = kolory[(naj | map(attribute="id") | list).index(k.id) % 4] if k.uwag else "var(--cx-ink-60)" %}
          <a class="kat-wiersz" href="#kat-{{ k.id }}" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px;padding:18px 0;border-top:1px solid var(--cx-ink-60);">
            <div style="flex:0 0 160px;display:flex;align-items:center;gap:12px;">
              <span style="width:12px;height:12px;border-radius:3px;background:{{ kolor }};flex:none;"></span>
              <span style="font-size:17px;">{{ k.nazwa }}</span>
            </div>
            <div style="flex:0 0 110px;display:flex;align-items:baseline;gap:8px;">
              <span style="font-family:var(--font-display);font-size:40px;line-height:1;font-variant-numeric:tabular-nums;">{{ k.uwag }}</span>
              <span style="font-size:14px;color:var(--cx-ink-40);">{{ k.udzial }}%</span>
            </div>
            <span style="flex:1 1 280px;min-width:0;font-size:15px;line-height:1.45;color:var(--cx-lime-soft);">{{ k.zdanie }}</span>
            <span style="display:inline-flex;align-items:center;gap:6px;font-size:14px;white-space:nowrap;">Zobacz {{ k.uwag }} {{ odmiana(k.uwag, "uwagę", "uwagi", "uwag") }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg></span>
          </a>
          {% endif %}
          {% endfor %}
        </div>
      </div>

      {% if r.pokrycie %}
      <div style="background:rgb(255,247,219);border:1px solid rgb(240,215,140);border-radius:24px;padding:clamp(20px,3cqw,32px);display:flex;flex-direction:column;gap:20px;">
        <div style="display:flex;gap:16px;align-items:flex-start;">
          <span style="width:44px;height:44px;border-radius:12px;background:rgb(122,86,0);color:#fff;display:flex;align-items:center;justify-content:center;flex:none;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg></span>
          <div style="display:flex;flex-direction:column;gap:6px;min-width:0;">
            <h3 style="font-size:clamp(22px,2.6cqw,28px);color:rgb(74,52,0);">Czego ten raport nie sprawdził</h3>
            <p style="color:rgb(90,64,0);"><strong style="font-weight:700;">Brak uwag w tych obszarach nie znaczy, że są w porządku.</strong> Audyt zbadał tylko część przypadków albo API monday nie udostępnia danych.</p>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:12px;">
          {% for p in r.pokrycie %}
          <div style="background:#fff;border:1px solid rgb(240,215,140);border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:10px;">
            <span style="font-weight:600;font-size:15px;">{{ p.temat }}</span>
            {% if p.niezmierzone %}
            <span style="font-family:var(--font-display);font-size:26px;line-height:1.1;color:var(--cx-gray-1);">nie zmierzone</span>
            <div style="height:8px;border-radius:4px;border:1.5px dashed rgb(210,180,110);"></div>
            {% else %}
            <div style="display:flex;flex-direction:column;gap:4px;"><span style="font-family:var(--font-display);font-size:36px;line-height:1;color:rgb(122,86,0);font-variant-numeric:tabular-nums;">{{ p.procent }}%</span><span style="font-size:14px;line-height:1.4;color:var(--cx-gray-1);">zbadano {{ p.zbadanych }} z {{ p.wszystkich }}</span></div>
            <div style="height:8px;border-radius:4px;background:rgb(250,234,188);overflow:hidden;"><div style="height:100%;width:{{ p.procent }}%;background:rgb(122,86,0);border-radius:4px;"></div></div>
            {% endif %}
            <p style="font-size:14px;line-height:1.45;color:var(--cx-gray-1);">{{ p.tekst }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if r.zastrzezenia %}
      <div style="background:#fff;border:1px solid var(--cx-cloud);border-radius:16px;padding:20px 24px;display:flex;flex-direction:column;gap:10px;">
        <strong style="font-weight:600;font-size:15px;">Pozostałe zastrzeżenia do danych</strong>
        {% for z in r.zastrzezenia %}<div style="display:flex;gap:10px;font-size:15px;color:var(--cx-gray-1);"><span style="color:rgb(122,86,0);flex:none;">—</span><span>{{ z }}</span></div>{% endfor %}
      </div>
      {% endif %}

      <p style="font-size:13px;color:var(--cx-gray-3);">Raport z nazwiskami, wygenerowany jednorazowo — CXLABS nie przechowuje jego kopii.{% if r.nieznane_hashe %} {{ r.nieznane_hashe }} {{ odmiana(r.nieznane_hashe, "konto", "konta", "kont") }} bez rozwiniętej nazwy oznaczono jako „nieznane konto".{% endif %}</p>
    </div>
  </main>

  {# ═══ D · RAPORT POGŁĘBIONY KATEGORII ════════════════════════════════ #}
  {% for k in r.zmierzone %}
  <section class="widok" id="kat-{{ k.id }}">
    {{ naglowek(k.nazwa, [("Audyt monday.com", None), ("Raport audytu", "#glowny"), (k.nazwa, None)]) }}
    <div style="max-width:960px;margin:0 auto;padding:clamp(24px,4cqw,48px) clamp(20px,5cqw,64px) clamp(48px,6cqw,80px);display:flex;flex-direction:column;gap:clamp(20px,3cqw,32px);">
      {{ metadane(True) }}

      <div style="display:flex;flex-wrap:wrap;gap:12px 32px;align-items:baseline;">
        <span style="font-family:var(--font-display);font-size:clamp(24px,2.8cqw,32px);">{{ k.uwag }} {{ odmiana(k.uwag, "uwaga krytyczna", "uwagi krytyczne", "uwag krytycznych") }}</span>
        {% if k.grupy %}<span style="color:var(--cx-gray-2);">w {{ k.grupy | length }} {{ odmiana(k.grupy | length, "rodzaju problemu", "rodzajach problemów", "rodzajach problemów") }}, od najliczniejszych</span>{% endif %}
      </div>

      {% set zk = r.pokrycie_kategorii(k.id) %}
      {% if zk %}
      <div style="background:#fff;border:1px solid var(--cx-cloud);border-radius:16px;padding:20px 24px;display:flex;flex-direction:column;gap:10px;">
        <strong style="font-weight:600;font-size:15px;">Zastrzeżenia kategorii</strong>
        {% for p in zk %}<div style="display:flex;gap:10px;font-size:15px;color:var(--cx-gray-1);"><span style="color:rgb(122,86,0);flex:none;">—</span><span><strong style="font-weight:600;color:var(--cx-ink);">{{ p.temat }}:</strong> {{ p.tekst }}</span></div>{% endfor %}
      </div>
      {% endif %}

      {% if not k.grupy %}
      <div style="background:#fff;border:1px dashed var(--cx-cloud-2);border-radius:16px;padding:32px;color:var(--cx-gray-2);">Audyt nie znalazł w tej kategorii uwag krytycznych.</div>
      {% endif %}

      {% for g in k.grupy %}
      <div class="grupa" style="background:#fff;border:1px solid var(--cx-cloud-2);border-radius:16px;overflow:hidden;">
        <div style="padding:clamp(18px,2.6cqw,24px);display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <h3 style="font-size:clamp(20px,2.2cqw,24px);">{{ g.nazwa_klasy }}</h3>
            <span style="background:var(--cx-ink);color:var(--cx-mist);border-radius:8px;padding:2px 10px;font-size:14px;">{{ g.uwagi | length }} {{ odmiana(g.uwagi | length, "uwaga", "uwagi", "uwag") }}</span>
          </div>
          {% if g.wspolna_rekomendacja %}
          <div style="background:var(--cx-mist);border-radius:12px;padding:12px 16px;font-size:15px;"><span style="color:var(--cx-ink-10);font-weight:600;">Rekomendacja dla całej grupy: </span>{{ g.wspolna_rekomendacja }}</div>
          {% endif %}
        </div>
        <div class="grupa-wiersz-nag" style="gap:24px;padding:10px 24px;background:var(--cx-paper);border-top:1px solid var(--cx-cloud);font-size:13px;color:var(--cx-gray-2);">
          <span style="flex:1.1 1 240px;">Opis</span>{% if not g.wspolna_rekomendacja %}<span style="flex:1 1 220px;">Rekomendacja</span>{% endif %}<span style="flex:1.4 1 280px;">Dowód</span><span style="flex:0 0 72px;">Źródło</span>
        </div>
        {% for u in g.uwagi %}
        <div style="display:flex;flex-wrap:wrap;gap:14px 24px;padding:18px 24px;border-top:1px solid var(--cx-cloud);">
          <div style="flex:1.1 1 240px;min-width:0;display:flex;flex-direction:column;gap:4px;">
            <span class="etykieta-m">Opis</span>
            <p style="font-size:15px;line-height:1.5;">{{ u.opis }}</p>
          </div>
          {% if not g.wspolna_rekomendacja %}
          <div style="flex:1 1 220px;min-width:0;display:flex;flex-direction:column;gap:4px;">
            <span class="etykieta-m">Rekomendacja</span>
            <p style="font-size:15px;line-height:1.5;display:flex;gap:8px;"><span style="color:var(--cx-ink-10);flex:none;">→</span><span>{{ u.rekomendacja }}</span></p>
          </div>
          {% endif %}
          <div style="flex:1.4 1 280px;min-width:0;display:flex;flex-direction:column;gap:6px;">
            <span class="etykieta-m">Dowód</span>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              {% for c in u.chipy %}
              {% if c.niezmierzone %}
              <span style="display:inline-flex;flex-direction:column;gap:2px;padding:6px 10px;border-radius:8px;background:#fff;border:1.5px dashed var(--cx-gray-3);font-size:13px;line-height:1.4;max-width:100%;"><span><span style="color:var(--cx-gray-2);">{{ c.etykieta }}: </span><span style="color:var(--cx-gray-1);font-weight:600;">nie zmierzone</span></span><span style="color:var(--cx-gray-2);">{{ c.powod }}</span></span>
              {% else %}
              <span style="display:inline-flex;flex-wrap:wrap;gap:4px;padding:4px 10px;border-radius:8px;background:var(--cx-paper);border:1px solid var(--cx-cloud);font-size:13px;line-height:1.4;max-width:100%;overflow-wrap:anywhere;"><span style="color:var(--cx-gray-2);">{{ c.etykieta }}:</span><span style="color:var(--cx-ink);font-weight:600;">{{ c.wartosc }}</span></span>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          <div style="flex:0 0 72px;display:flex;flex-direction:column;gap:4px;align-items:flex-start;">
            <span class="etykieta-m">Źródło</span>
            {% if u.zrodlo == "szablon" %}<span style="background:#fff;border:1px solid var(--cx-cloud-2);color:var(--cx-gray-1);border-radius:6px;padding:2px 8px;font-size:12px;">szablon</span>
            {% else %}<span style="background:var(--cx-ink-80);color:var(--cx-mist);border-radius:6px;padding:2px 8px;font-size:12px;">AI</span>{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</div>
</html>
