{# Raport uwag krytycznych (faza 5c, wariant A). Wygląd tymczasowy — faza 7.

   Dokument niesie NAZWISKA pracowników klienta. Powstaje raz, w trakcie runu,
   i nie ma kopii na serwerze. Jeden plik, zero zasobów zewnętrznych.
#}
{% from "_makra.html.j2" import wartosc_dowodu %}
<!doctype html>
<html lang="pl">
<meta charset="utf-8">
<title>Uwagi krytyczne — {{ r.client_id }} — {{ r.run_at[:10] }}</title>
<style>
{% include "_marka.css.j2" %}
  body { max-width: 900px; margin: 0 auto; padding: var(--space-7) var(--space-6); }
  .znak { height: 32px; width: auto; margin-bottom: var(--space-4); display: block; }
  .meta { color: var(--fg-muted); font-size: var(--fs-small); }
  .spis { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4);
          font-size: var(--fs-small); margin: var(--space-4) 0 var(--space-6); }
  .grupa { border: 1px solid var(--border-subtle); border-radius: var(--radius-xl);
           padding: var(--space-5) var(--space-6); margin: var(--space-6) 0; }
  .grupa h2 { margin: 0 0 var(--space-3); }
  .liczba { color: var(--fg-muted); font-weight: 400; }
  table.dowod th { text-align: left; font-size: var(--fs-xs); color: var(--fg-muted);
                   padding: var(--space-1) var(--space-2); }
  tr.opis td { border-top: none; padding-bottom: var(--space-3); }
  summary { cursor: pointer; color: var(--fg-muted); }
  .zrodlo { color: var(--fg-muted); font-size: var(--fs-xs); text-transform: uppercase; }
  .rekomendacja { font-weight: 600; }
  table.dowod { font-size: var(--fs-small); border-collapse: collapse; width: 100%; }
  table.dowod td { padding: var(--space-1) var(--space-2); vertical-align: top;
                   border-top: 1px solid var(--border-subtle); }
  pre { white-space: pre-wrap; margin: 0; }
</style>
{% if logo %}<img class="znak" src="{{ logo }}" alt="CXLABS">{% endif %}
<h1>Uwagi krytyczne</h1>
<p class="meta">{{ r.client_id }} · {{ r.run_at[:10] }} · run {{ r.run_id }} ·
  {{ r.uwagi | length }} {{ odmiana(r.uwagi | length, "uwaga", "uwagi", "uwag") }},
  {{ r.pominietych }} {{ odmiana(r.pominietych, "hipoteza sprawdzona i odrzucona", "hipotezy sprawdzone i odrzucone", "hipotez sprawdzonych i odrzuconych") }}</p>

{% if r.zastrzezenia %}
<h2>Czego ten raport nie obejmuje</h2>
<ul>{% for z in r.zastrzezenia %}<li>{{ z }}</li>{% endfor %}</ul>
{% endif %}

<nav class="spis">
{% for g in r.grupy %}<a href="#{{ g.klasa_id }}">{{ g.nazwa_klasy }} ({{ g.uwagi | length }})</a>{% endfor %}
</nav>

{% for g in r.grupy %}
<section class="grupa" id="{{ g.klasa_id }}">
  <h2>{{ g.nazwa_klasy }} <span class="liczba">{{ g.uwagi | length }}</span></h2>
  {% if g.wspolna_rekomendacja %}<p class="rekomendacja">→ {{ g.wspolna_rekomendacja }}</p>{% endif %}
  <table class="dowod">
    <tr>{% for k in g.kolumny %}<th>{{ k | etykieta }}</th>{% endfor %}</tr>
    {% for u in g.uwagi %}
    <tr>{% for k in g.kolumny %}<td>{{ wartosc_dowodu(u.dowod.get(k)) }}</td>{% endfor %}</tr>
    <tr class="opis"><td colspan="{{ g.kolumny | length }}">
      <details><summary>{{ u.opis | truncate(140) }}</summary>
        <p>{{ u.opis }}</p>
        {% if not g.wspolna_rekomendacja %}<p class="rekomendacja">→ {{ u.rekomendacja }}</p>{% endif %}
        {% if u.zrodlo == "szablon" %}<p class="zrodlo">reguła, nie model</p>{% endif %}
      </details>
    </td></tr>
    {% endfor %}
  </table>
</section>
{% endfor %}

{% if r.nieznane_hashe %}
<p class="meta">{{ r.nieznane_hashe }} kont bez rozwiniętej nazwy — oznaczone jako „nieznane konto".</p>
{% endif %}
</html>
